{
  "name": "kingdomshiftlive-site",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "prepare:db": "node scripts/prepare-migrations.mjs",
    "typecheck": "deno check --config supabase/functions/platform/deno.json supabase/functions/platform/index.ts",
    "lint": "deno lint --config supabase/functions/platform/deno.json supabase/functions/platform/index.ts && deno lint --ext=js supabase/functions/_shared/platform.mjs supabase/functions/_shared/zego-token.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.2",
    "@zegocloud/zego-uikit-prebuilt": "2.18.5",
    "deno": "2.9.6",
    "stripe": "23.0.1"
  }
}
