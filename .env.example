# Staging placeholders only: replace with the explicitly authorized project/site.
# Never point a synthetic sandbox at a production ledger.
# PUBLIC build variables (never use a service-role key here).
PUBLIC_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Supabase Edge function secrets/settings. Configure through the provider's
# secure settings; never commit values or copy them into browser configuration.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase at runtime.
SITE_URL=https://your-staging-site.example.invalid/
ALLOWED_ORIGINS=https://your-staging-site.example.invalid
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_MODE=disabled
LIVE_BILLING_APPROVED=false
PRO_ENABLED=false
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
STREAMING_ENABLED=false
DELETION_PROCESSING_ENABLED=false

# Deployment access, only when authorized. Never a browser variable.
SUPABASE_PROJECT_REF=YOUR-STAGING-PROJECT
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
